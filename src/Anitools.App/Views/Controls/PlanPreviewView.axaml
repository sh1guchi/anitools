<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anitools.App.ViewModels"
             xmlns:c="using:Anitools.App.Views.Controls"
             x:Class="Anitools.App.Views.Controls.PlanPreviewView"
             x:DataType="vm:PlanPreviewViewModel">
  <!-- Файлы и что с ними будет (.tbl в карточке); снятая галочка — файл не трогать -->
  <Border Classes="card" Padding="0,14,0,6" VerticalAlignment="Top" IsVisible="{Binding HasRows}">
    <DockPanel>
      <c:CardHead DockPanel.Dock="Top" Icon="FileMultipleOutline" Title="Файлы" Margin="18,0,18,8">
        <TextBlock x:Name="SummaryText" Classes="dim" FontSize="13" Text="{Binding Summary}" />
      </c:CardHead>
      <Border DockPanel.Dock="Top" Classes="tblHead" Margin="10,0">
        <Grid ColumnDefinitions="30,*,86,1.25*">
          <CheckBox x:Name="AllBox" IsThreeState="True" IsChecked="{Binding AllChecked}" MinWidth="0" MinHeight="0" Padding="0"
                    ToolTip.Tip="Отметить все" />
          <TextBlock Grid.Column="1" Text="Файл" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Размер" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,18,0" />
          <TextBlock Grid.Column="3" Text="Что будет" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Margin="10,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PlanRowViewModel">
              <Border Classes="tblRow">
                <Grid ColumnDefinitions="30,*,86,1.25*">
                  <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanRun}" MinWidth="0" MinHeight="0" Padding="0" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="Medium" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" Margin="0,0,12,0"
                             Classes.faint="{Binding !CanRun}" />
                  <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="dim sm" VerticalAlignment="Center"
                             HorizontalAlignment="Right" Margin="0,0,18,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Target}" Classes="text2 sm" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Target}" IsVisible="{Binding CanRun}" />
                  <Grid Grid.Column="3" ColumnDefinitions="Auto,*" IsVisible="{Binding IsSkip}">
                    <Border Classes="badge warn" Margin="0,0,8,0">
                      <TextBlock Text="пропуск" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Reason}" Classes="dim sm" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Reason}" />
                  </Grid>
                  <Grid Grid.Column="3" ColumnDefinitions="Auto,*" IsVisible="{Binding IsError}">
                    <Border Classes="badge err" Margin="0,0,8,0">
                      <TextBlock Text="ошибка" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Reason}" Classes="err sm" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Reason}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
