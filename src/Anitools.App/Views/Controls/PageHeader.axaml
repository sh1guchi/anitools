<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anitools.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Controls.PageHeader"
             x:DataType="vm:PageViewModel">
  <!-- Почему нечего показать или запустить: нет папки, нет файлов, нет программы, ошибка чтения (.note) -->
  <Border Classes="note" Margin="0,0,0,14" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
    <Grid ColumnDefinitions="Auto,*">
      <mi:MaterialIcon Kind="AlertCircleOutline" VerticalAlignment="Top" Margin="0,1,9,0" />
      <SelectableTextBlock x:Name="MessageText" Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />
    </Grid>
  </Border>
</UserControl>
