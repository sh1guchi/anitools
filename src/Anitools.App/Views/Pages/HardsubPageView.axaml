<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.HardsubPageView"
             x:DataType="p:HardsubPageViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="pageBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <mi:MaterialIcon Kind="InformationOutline" Classes="cyan" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Grid.Column="1" Classes="text2" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                   Text="Пары «видео + .ass с тем же именем» → папка «Hardsub» с вшитыми субтитрами. Готовый файл перезаписывается." />
        <Button x:Name="RunButton" Grid.Column="2" Classes="primary lg" Command="{Binding RunCommand}"
                IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Play" />
            <TextBlock x:Name="RunText" Text="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <DockPanel Margin="22,18,22,14">
      <c:PageHeader DockPanel.Dock="Top" />
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
        <Grid ColumnDefinitions="Auto,28,*">
          <HeaderedContentControl Classes="field" Header="Шрифты">
            <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="30">
              <mi:MaterialIcon Kind="FormatFont" Classes="accent" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock x:Name="FontsInfoText" Text="{Binding FontsInfo}" VerticalAlignment="Center" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Grid.Column="2" Classes="field" Header="Кодирование — меняется в «Настройках»">
            <Border Background="{StaticResource Panel3Brush}" CornerRadius="6" Padding="8,6">
              <TextBlock Classes="mono" Text="{Binding Profile}" TextWrapping="Wrap" />
            </Border>
          </HeaderedContentControl>
        </Grid>
      </Border>
      <c:PlanPreviewView DataContext="{Binding Preview}" />
    </DockPanel>
  </DockPanel>
</UserControl>
