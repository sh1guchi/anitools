<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.AssFontsPageView"
             x:DataType="p:AssFontsPageViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="pageBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <mi:MaterialIcon Kind="InformationOutline" Classes="cyan" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Grid.Column="1" Classes="text2" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                   Text="{Binding FilesCaption}" />
        <Button x:Name="RunButton" Grid.Column="2" Classes="primary lg" Command="{Binding RunCommand}"
                IsEnabled="{Binding FontNames.Count, Converter={x:Static v:Converters.IsPositive}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="FolderZipOutline" />
            <TextBlock Text="Собрать fonts.zip" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <DockPanel Margin="22,18,22,14">
      <c:PageHeader DockPanel.Dock="Top" />
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
        <StackPanel Spacing="12">
          <HeaderedContentControl Classes="field" Header="Своя папка шрифтов">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding CustomDir}" PlaceholderText="не задана" />
              <Button Grid.Column="1" Classes="icon" Command="{Binding BrowseCustomDirCommand}" ToolTip.Tip="Выбрать папку" Margin="4,0,0,0">
                <mi:MaterialIcon Kind="FolderSearchOutline" />
              </Button>
            </Grid>
          </HeaderedContentControl>
          <CheckBox Content="скачивать, чего нет (Google Fonts, dafont, 1001fonts) — и сохранять в свою папку" IsChecked="{Binding Download}" />
          <Grid Classes="hint">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <mi:MaterialIcon Kind="InformationOutline" />
            <TextBlock Grid.Column="1"
                       Text="Поиск: своя папка → системные шрифты → скачивание. Без кириллицы шрифт не берётся, если есть кириллический с тем же именем. Архив — fonts.zip рядом с .ass." />
          </Grid>
        </StackPanel>
      </Border>
      <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,14,0,0"
              IsVisible="{Binding Result, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <mi:MaterialIcon Kind="CheckCircleOutline" Classes="ok" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="ResultText" Grid.Column="1" Text="{Binding Result}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="sm" Command="{Binding OpenZipFolderCommand}"
                    IsVisible="{Binding ZipPath, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="FolderOpenOutline" />
                <TextBlock Text="Открыть папку" />
              </StackPanel>
            </Button>
          </Grid>
          <ItemsControl ItemsSource="{Binding NotFound}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="p:MissingFontViewModel">
                <Border Classes="note err" Padding="12,6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="CloseCircleOutline" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="не найден нигде — поискать:" Classes="text2 sm" VerticalAlignment="Center" />
                    <Button Classes="link" Content="fontsquirrel" Command="{Binding OpenFontSquirrelCommand}" />
                    <Button Classes="link" Content="fontsgeek" Command="{Binding OpenFontsGeekCommand}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding FontNames.Count, Converter={x:Static v:Converters.IsPositive}}">
        <DockPanel>
          <c:CardHead DockPanel.Dock="Top" Icon="FormatFont" Title="Шрифты в субтитрах" Caption="{Binding FontNames.Count}" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="FontsList" ItemsSource="{Binding FontNames}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="x:String">
                  <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                          CornerRadius="20" Padding="11,4">
                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource Text2Brush}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DockPanel>
  </DockPanel>
</UserControl>
