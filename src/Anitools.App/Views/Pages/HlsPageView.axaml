<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.HlsPageView"
             x:DataType="p:HlsPageViewModel">
  <DockPanel Margin="24,18,24,16">
    <c:PageHeader DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Top" Classes="message" Margin="0,0,0,10"
            IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="Качество:" VerticalAlignment="Center" Margin="0,0,12,0" />
          <RadioButton GroupName="hlsCq" Content="постоянное CQ" IsChecked="{Binding UseFixedCq}" Margin="0,0,6,0" />
          <TextBox Text="{Binding FixedCq}" Width="60" IsEnabled="{Binding UseFixedCq}" Margin="0,0,16,0" />
          <RadioButton GroupName="hlsCq" Content="подбор под размер" IsChecked="{Binding !UseFixedCq}" Margin="0,0,24,0" />
          <RadioButton GroupName="hlsEnc" Content="NVENC" IsChecked="{Binding UseNvenc}" Margin="0,0,6,0" />
          <ComboBox ItemsSource="{Binding NvencPresets}" SelectedItem="{Binding NvencPreset}" IsEnabled="{Binding UseNvenc}" Width="80" Margin="0,0,16,0" />
          <RadioButton GroupName="hlsEnc" Content="процессор" IsChecked="{Binding !UseNvenc}" />
        </WrapPanel>
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="Временные файлы:" VerticalAlignment="Center" Margin="0,0,12,0" />
          <RadioButton GroupName="hlsWork" Content="RAM-диск" IsChecked="{Binding IsRamDisk}" Margin="0,0,6,0" />
          <TextBox Text="{Binding RamDiskGb}" Width="56" IsEnabled="{Binding IsRamDisk}" />
          <TextBlock Text="ГБ" VerticalAlignment="Center" Margin="6,0,16,0" />
          <RadioButton GroupName="hlsWork" Content="папка" IsChecked="{Binding IsFolder}" Margin="0,0,6,0" />
          <TextBox Text="{Binding WorkDirFolder}" Width="200" IsEnabled="{Binding IsFolder}" />
          <Button Content="…" Command="{Binding BrowseWorkDirCommand}" IsEnabled="{Binding IsFolder}" Margin="4,0,16,0" />
          <RadioButton GroupName="hlsWork" Content="рядом с выходом" IsChecked="{Binding IsNearOutput}" />
        </WrapPanel>
        <CheckBox Content="Выключить компьютер по завершении" IsChecked="{Binding Shutdown}" IsVisible="{Binding CanShutdown}" />
      </StackPanel>
    </Border>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="SummaryText" Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
      <Button x:Name="RunButton" Grid.Column="1" Classes="accent" Padding="20,8" Command="{Binding RunCommand}"
              IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}"
              Content="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
    </Grid>
    <Grid RowDefinitions="*,8,*">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" Margin="0,0,12,0">

        <Border Classes="card">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="Тайтлы" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Перегруппировать…" Command="{Binding RegroupCommand}" />
            </Grid>
            <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="p:HlsGroupViewModel">
                  <StackPanel Spacing="4" Margin="0,4,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                      <CheckBox IsChecked="{Binding IsIncluded}" MinWidth="0">
                        <TextBlock>
                          <Run Text="{Binding Title}" FontWeight="SemiBold" />
                          <Run Text="{Binding FilesText}" Foreground="Gray" />
                        </TextBlock>
                      </CheckBox>
                      <TextBlock Grid.Column="2" Text="{Binding ShikimoriText}" Classes="muted" VerticalAlignment="Center" Margin="12,0" />
                      <Button Grid.Column="3" Command="{Binding PickShikimoriCommand}" IsEnabled="{Binding IsIncluded}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <mi:MaterialIcon Kind="Magnify" />
                          <TextBlock Text="Shikimori" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="4" Classes="icon" Command="{Binding ClearShikimoriCommand}" IsVisible="{Binding HasShikimori}"
                              ToolTip.Tip="Без Shikimori — папка по названию" Margin="4,0,0,0">
                        <mi:MaterialIcon Kind="Close" />
                      </Button>
                    </Grid>
                    <StackPanel Spacing="4" Margin="28,0,0,0" IsVisible="{Binding IsIncluded}">
                      <TextBlock Classes="muted small">
                        <Run Text="Папка:" />
                        <Run Text="{Binding TitleFolder}" />
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding Layouts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="p:HlsLayoutViewModel">
                            <StackPanel Spacing="2" Margin="0,4,0,0">
                              <TextBlock Text="{Binding Header}" Classes="small" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="p:HlsVoiceRowViewModel">
                                    <Grid ColumnDefinitions="Auto,28,*,60,60,240" Margin="0,1">
                                      <CheckBox IsChecked="{Binding IsTaken}" MinWidth="0" ToolTip.Tip="Брать дорожку" />
                                      <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="muted" VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                      <TextBlock Grid.Column="3" Text="{Binding Language}" Classes="muted" VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="4" Text="{Binding Channels}" Classes="muted" VerticalAlignment="Center" />
                                      <ComboBox Grid.Column="5" IsEditable="True" HorizontalAlignment="Stretch" Text="{Binding Voice}"
                                                IsEnabled="{Binding IsTaken}" PlaceholderText="озвучка"
                                                ItemsSource="{Binding $parent[UserControl].((p:HlsPageViewModel)DataContext).Voices}" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
    <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />
    <c:PlanPreviewView Grid.Row="2" DataContext="{Binding Preview}" />
    </Grid>
  </DockPanel>
</UserControl>
