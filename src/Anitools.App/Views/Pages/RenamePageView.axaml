<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.RenamePageView"
             x:DataType="p:RenamePageViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="pageBar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
          <TextBlock Classes="barTitle" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
          <Button Classes="link" HorizontalAlignment="Left" Command="{Binding UndoCommand}" Padding="0,1"
                  IsVisible="{Binding UndoText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="Undo" Width="15" Height="15" />
              <TextBlock x:Name="UndoTextBlock" Text="{Binding UndoText}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button x:Name="RenameButton" Grid.Column="1" Classes="primary lg" Command="{Binding RenameCommand}"
                IsEnabled="{Binding RenameCount, Converter={x:Static v:Converters.IsPositive}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="RenameOutline" />
            <TextBlock Text="{Binding RenameCount, StringFormat='Переименовать ({0})'}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <DockPanel Margin="22,18,22,14">
      <c:PageHeader DockPanel.Dock="Top" />
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
        <StackPanel Spacing="12">
          <!-- поля — только для переменных, которые есть в шаблоне -->
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <HeaderedContentControl Classes="field" Header="Базовое название" IsVisible="{Binding UsesTitle}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="BaseNameBox" Text="{Binding BaseName}" />
                <Button x:Name="ShikimoriButton" Grid.Column="1" Margin="8,0,0,0" Command="{Binding SearchShikimoriCommand}"
                        ToolTip.Tip="Искать на Shikimori то, что в поле, и взять оригинальное название">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <mi:MaterialIcon Kind="Magnify" />
                    <TextBlock Text="Найти на Shikimori" />
                  </StackPanel>
                </Button>
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="1" Classes="field" Header="Нумерация с" Margin="24,0,0,0" IsVisible="{Binding UsesEpisode}">
              <TextBox x:Name="StartBox" Text="{Binding NumberingStart}" Width="80" HorizontalAlignment="Left" />
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="2" Classes="field" Header="Сезон" Margin="24,0,0,0" IsVisible="{Binding UsesSeason}">
              <TextBox x:Name="SeasonBox" Text="{Binding Season}" Width="80" HorizontalAlignment="Left" />
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="3" Classes="field" Header="Суффикс" Margin="24,0,0,0" IsVisible="{Binding UsesSuffix}">
              <TextBox Text="{Binding Suffix}" Width="170" PlaceholderText="напр. надписи" HorizontalAlignment="Left" />
            </HeaderedContentControl>
          </Grid>
          <HeaderedContentControl Classes="field" Header="Шаблон имени · расширение остаётся своё">
            <c:TemplateEditor x:Name="TemplateEditor"
                              Text="{Binding Template}"
                              Issues="{Binding TemplateIssues}"
                              Presets="{Binding Presets}"
                              SavePresetCommand="{Binding SavePresetCommand}"
                              DeletePresetCommand="{Binding DeletePresetCommand}"
                              DefaultText="{x:Static p:RenamePageViewModel.DefaultTemplate}"
                              Variables="{x:Static p:RenamePageViewModel.TemplateVariables}"
                              Formatted="{x:Static p:RenamePageViewModel.TemplateFormatted}"
                              Conditions="{x:Static p:RenamePageViewModel.TemplateConditions}"
                              BuiltInPresets="{x:Static p:RenamePageViewModel.BuiltInPresets}" />
          </HeaderedContentControl>
          <Grid Classes="hint">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <mi:MaterialIcon Kind="InformationOutline" />
            <TextBlock Grid.Column="1" Text="Номер в строке можно поправить руками — он берётся как есть. Пустой номер — файл не трогать." />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="0,14,0,6" VerticalAlignment="Top" IsVisible="{Binding Rows.Count, Converter={x:Static v:Converters.IsPositive}}">
        <DockPanel>
          <c:CardHead DockPanel.Dock="Top" Icon="FileMultipleOutline" Title="Файлы" Margin="18,0,18,8" />
          <Border DockPanel.Dock="Top" Classes="tblHead" Margin="10,0">
            <Grid ColumnDefinitions="*,70,30,1.2*">
              <TextBlock Text="Сейчас" />
              <TextBlock Grid.Column="1" Text="Серия" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="Станет" />
            </Grid>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Margin="10,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="p:RenameRowViewModel">
                  <Border Classes="tblRow">
                    <Grid ColumnDefinitions="*,70,30,1.2*">
                      <TextBlock Text="{Binding File}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding File}" Margin="0,0,10,0" />
                      <TextBox Grid.Column="1" Classes="sm" Text="{Binding Episode}" HorizontalContentAlignment="Center"
                               FontWeight="{Binding IsManual, Converter={x:Static v:Converters.BoldIf}}" />
                      <mi:MaterialIcon Grid.Column="2" Kind="ArrowRight" Classes="faint" Width="15" Height="15" />
                      <!-- имя — сколько влезет (имена как у релизов длинные), пометка — справа; нет имени — пометка на его месте -->
                      <Grid Grid.Column="3" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding NewName}" VerticalAlignment="Center" HorizontalAlignment="Left" Classes="text2" Classes.faint="{Binding !WillRename}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NewName}" IsVisible="{Binding HasNewName}" />
                        <TextBlock Text="{Binding Note}" Classes="sm" Classes.err="{Binding IsProblem}" Classes.dim="{Binding !IsProblem}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding !HasNewName}" />
                        <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="sm" Classes.err="{Binding IsProblem}" Classes.dim="{Binding !IsProblem}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" MaxWidth="320"
                                   ToolTip.Tip="{Binding Note}" IsVisible="{Binding HasNewName}" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DockPanel>
  </DockPanel>
</UserControl>
