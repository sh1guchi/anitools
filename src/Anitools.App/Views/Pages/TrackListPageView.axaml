<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:ot="using:Anitools.Core.Operations.TrackList"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.TrackListPageView"
             x:DataType="p:TrackListPageViewModel">
  <DockPanel Margin="22,18,22,18">
    <c:PageHeader DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
      <HeaderedContentControl Classes="field" Header="Файл">
        <ComboBox x:Name="FileBox" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" HorizontalAlignment="Stretch" />
      </HeaderedContentControl>
    </Border>
    <Grid ColumnDefinitions="*,14,360">
      <Border Classes="card" Padding="0,14,0,6" VerticalAlignment="Top">
        <DockPanel>
          <c:CardHead DockPanel.Dock="Top" Icon="MusicNoteOutline" Title="Аудиодорожки" Margin="18,0,18,8" />
          <Border DockPanel.Dock="Top" Classes="tblHead" Margin="10,0">
            <Grid ColumnDefinitions="34,*,70,110,80,110">
              <TextBlock Text="#" />
              <TextBlock Grid.Column="1" Text="Тайтл" />
              <TextBlock Grid.Column="2" Text="Язык" />
              <TextBlock Grid.Column="3" Text="Кодек" />
              <TextBlock Grid.Column="4" Text="Каналы" />
            </Grid>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Margin="10,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="ot:TrackRow">
                  <Border Classes="tblRow" Padding="8,7">
                    <Grid ColumnDefinitions="34,*,70,110,80,110">
                      <TextBlock Text="{Binding Number}" Classes="cyan b" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Title, FallbackValue='—', TargetNullValue='—'}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Language}" Classes="dim sm" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Codec}" Classes="text2 sm" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Channels}" Classes="text2 sm" VerticalAlignment="Center" />
                      <Border Grid.Column="5" Classes="badge accent" HorizontalAlignment="Left" IsVisible="{Binding IsDefault}">
                        <TextBlock Text="по умолчанию" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <c:CardHead Icon="ContentCopy" Title="Список для копирования" Margin="0" />
          <Border Classes="seg">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="seg" GroupName="copyStyle" Content="• тайтл" IsChecked="{Binding IsBullets}" />
              <RadioButton x:Name="NumbersRadio" Classes="seg" GroupName="copyStyle" Content="1. тайтл" IsChecked="{Binding IsNumbers}" />
              <RadioButton Classes="seg" GroupName="copyStyle" Content="текст" IsChecked="{Binding IsPlain}" />
              <RadioButton x:Name="CommaRadio" Classes="seg" GroupName="copyStyle" Content="через запятую" IsChecked="{Binding IsComma}"
                           ToolTip.Tip="Одной строкой: русские озвучки, потом English, потом Original" />
            </StackPanel>
          </Border>
          <TextBox x:Name="CopyBox" Text="{Binding CopyText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="120" MaxHeight="320" VerticalContentAlignment="Top" />
          <Button Classes="primary" HorizontalAlignment="Right" Command="{Binding CopyCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <mi:MaterialIcon Kind="ContentCopy" />
              <TextBlock Text="Копировать" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
