<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.AudioMuxPageView"
             x:DataType="p:AudioMuxPageViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="pageBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <mi:MaterialIcon Kind="InformationOutline" Classes="cyan" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Grid.Column="1" Classes="text2" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                   Text="Видео + выбранные дорожки исходника + внешние озвучки → папка «Processed Audio», без перекодирования; порядок, тайтлы и язык — как в наборе." />
        <Button x:Name="RunButton" Grid.Column="2" Classes="primary lg" Command="{Binding RunCommand}"
                IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Play" />
            <TextBlock x:Name="RunText" Text="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <DockPanel Margin="22,18,22,14">
      <c:PageHeader DockPanel.Dock="Top" />
      <ScrollViewer DockPanel.Dock="Top" MaxHeight="470" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
        <StackPanel Spacing="14">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <c:CardHead Icon="MusicNoteOutline" Title="Дорожки исходника" Caption="{Binding TracksCaption}" Margin="0" />
              <ItemsControl ItemsSource="{Binding SourceTracks}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="p:AudioTrackRowViewModel">
                    <Border Classes="box" Padding="10,2,12,2">
                      <CheckBox IsChecked="{Binding IsSelected}" MinHeight="30">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Number}" Classes="cyan b" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Language}" Classes="dim sm" VerticalAlignment="Center" />
                        </StackPanel>
                      </CheckBox>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox x:Name="ExternalBox" Content="добавить внешние аудио серии (папки «Audio only», озвучки рядом)" IsChecked="{Binding UseExternal}" />
                <Panel Width="16" Height="16" IsVisible="{Binding IsAnalyzing}" VerticalAlignment="Center">
                  <Ellipse Classes="spinTrack" />
                  <Arc Classes="spin" />
                </Panel>
              </StackPanel>
            </StackPanel>
          </Border>

          <ItemsControl x:Name="SetsList" ItemsSource="{Binding Sets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="p:AudioSetViewModel">
                <Border Classes="card">
                  <StackPanel Spacing="6">
                    <c:CardHead Icon="PlaylistMusicOutline" Title="{Binding Header}" Margin="0,0,0,2">
                      <Button Classes="sm" Content="взять из набора 1" Command="{Binding CopyFromMainCommand}" IsVisible="{Binding !IsMain}" />
                    </c:CardHead>
                    <TextBlock Classes="dim sm" Text="{Binding Difference}" TextWrapping="Wrap" IsVisible="{Binding HasDifference}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Slots}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="p:AudioSlotRowViewModel">
                          <Border Classes="box" Padding="8,5">
                            <Grid ColumnDefinitions="28,*,220,100,82,Auto">
                              <TextBlock Text="{Binding Position}" Classes="cyan b" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding Source}" Margin="4,0,8,0" />
                              <ComboBox Grid.Column="2" IsEditable="True" HorizontalAlignment="Stretch" Text="{Binding Title}"
                                        PlaceholderText="{Binding TitlePlaceholder}"
                                        ItemsSource="{Binding $parent[UserControl].((p:AudioMuxPageViewModel)DataContext).Voices}" />
                              <ComboBox Grid.Column="3" IsEditable="True" HorizontalAlignment="Stretch" Margin="6,0,0,0" Text="{Binding Language}"
                                        PlaceholderText="язык"
                                        ItemsSource="{Binding $parent[UserControl].((p:AudioMuxPageViewModel)DataContext).LanguageCodes}" />
                              <Border Grid.Column="4" Classes="badge accent" HorizontalAlignment="Center" IsVisible="{Binding IsDefault}">
                                <TextBlock Text="по умолч." />
                              </Border>
                              <StackPanel Grid.Column="5" Orientation="Horizontal">
                                <Button Classes="icon" ToolTip.Tip="Выше" CommandParameter="{Binding}"
                                        Command="{Binding $parent[ItemsControl].((p:AudioSetViewModel)DataContext).MoveUpCommand}">
                                  <mi:MaterialIcon Kind="ArrowUp" />
                                </Button>
                                <Button Classes="icon" ToolTip.Tip="Ниже" CommandParameter="{Binding}"
                                        Command="{Binding $parent[ItemsControl].((p:AudioSetViewModel)DataContext).MoveDownCommand}">
                                  <mi:MaterialIcon Kind="ArrowDown" />
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <c:PlanPreviewView DataContext="{Binding Preview}" />
    </DockPanel>
  </DockPanel>
</UserControl>
