<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.AudioMuxPageView"
             x:DataType="p:AudioMuxPageViewModel">
  <DockPanel Margin="24,18,24,16">
    <c:PageHeader DockPanel.Dock="Top" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <Button x:Name="RunButton" Grid.Column="1" Classes="accent" Padding="20,8" Command="{Binding RunCommand}"
              IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}"
              Content="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
    </Grid>
    <ScrollViewer DockPanel.Dock="Top" MaxHeight="470" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
      <StackPanel Spacing="12" Margin="0,0,12,0">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="h2" Text="Дорожки исходника" />
              <TextBlock Classes="muted" Text="{Binding TracksCaption}" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SourceTracks}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="p:AudioTrackRowViewModel">
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,18,0">
                    <TextBlock>
                      <Run Text="{Binding Number}" />
                      <Run Text="{Binding Title}" FontWeight="SemiBold" />
                      <Run Text="{Binding Language}" Foreground="Gray" />
                    </TextBlock>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <CheckBox x:Name="ExternalBox" Content="добавить внешние аудио серии (папки «Audio only», озвучки рядом)" IsChecked="{Binding UseExternal}" />
              <ProgressBar IsIndeterminate="True" Width="80" MinWidth="0" IsVisible="{Binding IsAnalyzing}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ItemsControl x:Name="SetsList" ItemsSource="{Binding Sets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="p:AudioSetViewModel">
              <Border Classes="card" Margin="0,0,0,10">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="h2" Text="{Binding Header}" />
                      <TextBlock Classes="muted small" Text="{Binding Difference}" TextWrapping="Wrap" IsVisible="{Binding HasDifference}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="взять из набора 1" Command="{Binding CopyFromMainCommand}" IsVisible="{Binding !IsMain}" VerticalAlignment="Top" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="p:AudioSlotRowViewModel">
                        <Grid ColumnDefinitions="28,*,220,100,72,Auto" Margin="0,2">
                          <TextBlock Text="{Binding Position}" VerticalAlignment="Center" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Source}" Margin="0,0,8,0" />
                          <ComboBox Grid.Column="2" IsEditable="True" HorizontalAlignment="Stretch" Text="{Binding Title}"
                                    PlaceholderText="{Binding TitlePlaceholder}"
                                    ItemsSource="{Binding $parent[UserControl].((p:AudioMuxPageViewModel)DataContext).Voices}" />
                          <ComboBox Grid.Column="3" IsEditable="True" HorizontalAlignment="Stretch" Margin="6,0,0,0" Text="{Binding Language}"
                                    PlaceholderText="язык"
                                    ItemsSource="{Binding $parent[UserControl].((p:AudioMuxPageViewModel)DataContext).LanguageCodes}" />
                          <TextBlock Grid.Column="4" Text="по умолч." Classes="muted small" VerticalAlignment="Center" Margin="8,0,0,0"
                                     IsVisible="{Binding IsDefault}" />
                          <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Classes="icon" ToolTip.Tip="Выше" CommandParameter="{Binding}"
                                    Command="{Binding $parent[ItemsControl].((p:AudioSetViewModel)DataContext).MoveUpCommand}">
                              <mi:MaterialIcon Kind="ArrowUp" />
                            </Button>
                            <Button Classes="icon" ToolTip.Tip="Ниже" CommandParameter="{Binding}"
                                    Command="{Binding $parent[ItemsControl].((p:AudioSetViewModel)DataContext).MoveDownCommand}">
                              <mi:MaterialIcon Kind="ArrowDown" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <c:PlanPreviewView DataContext="{Binding Preview}" />
  </DockPanel>
</UserControl>
