<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.AssEditPageView"
             x:DataType="p:AssEditPageViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="pageBar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
          <TextBlock x:Name="SummaryText" Classes="barTitle" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Summary}" />
          <TextBlock Classes="dim" FontSize="12.5" Text="Перед правкой оригиналы копируются в папку «ass_backup_…»." />
        </StackPanel>
        <Button x:Name="RunButton" Grid.Column="1" Classes="primary lg" Command="{Binding RunCommand}"
                IsEnabled="{Binding RemoveCount, Converter={x:Static v:Converters.IsPositive}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Broom" />
            <TextBlock Text="Править" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <DockPanel Margin="22,18,22,14">
      <c:PageHeader DockPanel.Dock="Top" />
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
        <WrapPanel Orientation="Horizontal" ItemSpacing="28" LineSpacing="12">
          <HeaderedContentControl Classes="field" Header="Поле">
            <Border Classes="seg">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="seg" GroupName="assField" Content="стиль" IsChecked="{Binding IsStyle}" />
                <RadioButton x:Name="ActorRadio" Classes="seg" GroupName="assField" Content="актёр" IsChecked="{Binding IsActor}" />
              </StackPanel>
            </Border>
          </HeaderedContentControl>
          <HeaderedContentControl Classes="field" Header="Режим">
            <Border Classes="seg">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="seg" GroupName="assMode" Content="оставить отмеченные" IsChecked="{Binding KeepSelected}" />
                <RadioButton x:Name="RemoveRadio" Classes="seg" GroupName="assMode" Content="удалить отмеченные" IsChecked="{Binding RemovesSelected}" />
              </StackPanel>
            </Border>
          </HeaderedContentControl>
        </WrapPanel>
      </Border>
      <Border Classes="card" Padding="0,14,0,6" VerticalAlignment="Top" IsVisible="{Binding Values.Count, Converter={x:Static v:Converters.IsPositive}}">
        <DockPanel>
          <c:CardHead DockPanel.Dock="Top" Icon="FormatListBulleted" Title="Значения" Caption="{Binding SearchCaption}" Margin="18,0,18,10" />
          <!-- поиск: слова через запятую; Enter — отметить найденные -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="18,0,18,10">
            <TextBox x:Name="SearchBox" Text="{Binding Search}" PlaceholderText="поиск по значениям: слова через запятую, например «демонобогский»">
              <TextBox.InnerLeftContent>
                <mi:MaterialIcon Kind="Magnify" Classes="dim" Width="16" Height="16" Margin="10,0,0,0" />
              </TextBox.InnerLeftContent>
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding CheckFoundCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding CheckFoundCommand}" IsEnabled="{Binding HasSearch}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="CheckboxMultipleMarkedOutline" />
                <TextBlock Text="{Binding MatchCount, StringFormat='Отметить найденные ({0})'}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="ghost" Margin="4,0,0,0" Command="{Binding UncheckFoundCommand}" IsEnabled="{Binding HasSearch}"
                    Content="Снять отметку" />
          </Grid>
          <Border DockPanel.Dock="Top" Classes="tblHead" Margin="10,0">
            <Grid ColumnDefinitions="*,*">
              <TextBlock Text="Значение" />
              <TextBlock Grid.Column="1" Text="Например, в файле" />
            </Grid>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ValuesList" ItemsSource="{Binding Values}" Margin="10,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="p:AssValueRowViewModel">
                  <Border Classes="tblRow" IsVisible="{Binding IsMatch}">
                    <Grid ColumnDefinitions="*,*">
                      <CheckBox IsChecked="{Binding IsChecked}" MinHeight="0" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Display}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      </CheckBox>
                      <TextBlock Grid.Column="1" Text="{Binding Example}" Classes="dim sm" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DockPanel>
  </DockPanel>
</UserControl>
