<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.RemuxPageView"
             x:DataType="p:RemuxPageViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="pageBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <mi:MaterialIcon Kind="InformationOutline" Classes="cyan" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Grid.Column="1" Classes="text2" FontSize="13" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button x:Name="RunButton" Grid.Column="2" Classes="primary lg" Command="{Binding RunCommand}"
                IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Play" />
            <TextBlock x:Name="RunText" Text="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <DockPanel Margin="22,18,22,14">
      <c:PageHeader DockPanel.Dock="Top" />
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
        <StackPanel Spacing="14">
          <WrapPanel Orientation="Horizontal" ItemSpacing="28" LineSpacing="12">
            <HeaderedContentControl Classes="field" Header="Выходной формат">
              <Border Classes="seg">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="Mp4Radio" Classes="seg" GroupName="remux" Content="MP4" IsChecked="{Binding IsMp4}" />
                  <RadioButton x:Name="MkvRadio" Classes="seg" GroupName="remux" Content="MKV" IsChecked="{Binding IsMkv}" />
                  <RadioButton x:Name="M2tsRadio" Classes="seg" GroupName="remux" Content="Blu-ray M2TS → MKV" IsChecked="{Binding IsM2tsToMkv}" />
                </StackPanel>
              </Border>
            </HeaderedContentControl>
            <HeaderedContentControl Classes="field" Header="Субтитры" IsVisible="{Binding IsMkv}">
              <CheckBox x:Name="SubsBox" Content="копировать в MKV" IsChecked="{Binding CopySubtitles}" MinHeight="34" />
            </HeaderedContentControl>
          </WrapPanel>
          <HeaderedContentControl Classes="field" Header="Входящие форматы">
            <ItemsControl ItemsSource="{Binding InputFormats}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="badge">
                    <TextBlock Text="{Binding}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </HeaderedContentControl>
        </StackPanel>
      </Border>
      <c:PlanPreviewView DataContext="{Binding Preview}" />
    </DockPanel>
  </DockPanel>
</UserControl>
