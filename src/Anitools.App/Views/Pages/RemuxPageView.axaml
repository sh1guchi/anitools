<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             x:Class="Anitools.App.Views.Pages.RemuxPageView"
             x:DataType="p:RemuxPageViewModel">
  <DockPanel Margin="24,18,24,16">
    <c:PageHeader DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="Формат:" VerticalAlignment="Center" Margin="0,0,12,0" />
          <RadioButton x:Name="Mp4Radio" GroupName="remux" Content="MP4" IsChecked="{Binding IsMp4}" Margin="0,0,16,0" />
          <RadioButton x:Name="MkvRadio" GroupName="remux" Content="MKV" IsChecked="{Binding IsMkv}" Margin="0,0,16,0" />
          <RadioButton x:Name="M2tsRadio" GroupName="remux" Content="Blu-ray M2TS → MKV" IsChecked="{Binding IsM2tsToMkv}" />
        </WrapPanel>
        <CheckBox x:Name="SubsBox" Content="копировать субтитры" IsChecked="{Binding CopySubtitles}" IsVisible="{Binding IsMkv}" />
        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <Button x:Name="RunButton" Grid.Column="1" Classes="accent" Padding="20,8"
              Command="{Binding RunCommand}"
              IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}"
              Content="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
    </Grid>
    <c:PlanPreviewView DataContext="{Binding Preview}" />
  </DockPanel>
</UserControl>
