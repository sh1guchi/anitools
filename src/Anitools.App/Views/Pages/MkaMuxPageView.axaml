<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.MkaMuxPageView"
             x:DataType="p:MkaMuxPageViewModel">
  <DockPanel Margin="24,18,24,16">
    <c:PageHeader DockPanel.Dock="Top" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <Button x:Name="RunButton" Grid.Column="1" Classes="accent" Padding="20,8" Command="{Binding RunCommand}"
              IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}"
              Content="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
    </Grid>
    <ScrollViewer DockPanel.Dock="Top" MaxHeight="420" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
      <Border Classes="card" Margin="0,0,12,0">
        <StackPanel Spacing="8">
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton GroupName="mkaMode" Content="по сериям" IsChecked="{Binding IsByEpisode}" Margin="0,0,16,0" />
            <RadioButton x:Name="SingleRadio" GroupName="mkaMode" Content="всё в один:" IsChecked="{Binding IsSingleFile}" Margin="0,0,6,0" />
            <TextBox Text="{Binding SingleName}" Width="240" IsEnabled="{Binding IsSingleFile}" />
            <TextBlock Text="{Binding FilesCaption}" Classes="muted" VerticalAlignment="Center" Margin="16,0,0,0" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox Content="язык дорожек по умолчанию" IsChecked="{Binding SetLanguage}" />
            <TextBox Text="{Binding Language}" Width="70" IsEnabled="{Binding SetLanguage}" />
            <TextBlock Text="оригинальная и английская озвучки определяются сами" Classes="muted small" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="h2" Text="Озвучки — по порядку дорожек; первая станет дорожкой по умолчанию" Margin="0,4,0,0" />
          <ItemsControl x:Name="LabelsList" ItemsSource="{Binding Labels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="p:MkaLabelRowViewModel">
                <Grid ColumnDefinitions="28,200,*,240,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Position}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Example}" Classes="muted small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                  <ComboBox Grid.Column="3" IsEditable="True" HorizontalAlignment="Stretch" Text="{Binding Title}"
                            ItemsSource="{Binding $parent[UserControl].((p:MkaMuxPageViewModel)DataContext).Voices}" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button Classes="icon" ToolTip.Tip="Выше" CommandParameter="{Binding}"
                            Command="{Binding $parent[UserControl].((p:MkaMuxPageViewModel)DataContext).MoveUpCommand}">
                      <mi:MaterialIcon Kind="ArrowUp" />
                    </Button>
                    <Button Classes="icon" ToolTip.Tip="Ниже" CommandParameter="{Binding}"
                            Command="{Binding $parent[UserControl].((p:MkaMuxPageViewModel)DataContext).MoveDownCommand}">
                      <mi:MaterialIcon Kind="ArrowDown" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </ScrollViewer>
    <c:PlanPreviewView DataContext="{Binding Preview}" />
  </DockPanel>
</UserControl>
