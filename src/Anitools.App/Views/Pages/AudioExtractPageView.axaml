<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.AudioExtractPageView"
             x:DataType="p:AudioExtractPageViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="pageBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <mi:MaterialIcon Kind="InformationOutline" Classes="cyan" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Grid.Column="1" Classes="text2" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                   Text="Выбранные дорожки каждой серии — без перекодирования: отдельными файлами по папкам озвучек или вместе в один .mka." />
        <Button x:Name="RunButton" Grid.Column="2" Classes="primary lg" Command="{Binding RunCommand}"
                IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Play" />
            <TextBlock x:Name="RunText" Text="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <DockPanel Margin="22,18,22,14">
      <c:PageHeader DockPanel.Dock="Top" />
      <ScrollViewer DockPanel.Dock="Top" MaxHeight="440" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
        <StackPanel Spacing="14">
          <Border Classes="card" IsVisible="{Binding Tracks.Count, Converter={x:Static v:Converters.IsPositive}}">
            <StackPanel>
              <c:CardHead Icon="MusicNoteOutline" Title="Дорожки" Caption="{Binding TracksCaption}" Margin="0,0,0,8" />
              <ItemsControl x:Name="TracksList" ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="p:AudioTrackRowViewModel">
                    <Border Classes="tblRow">
                      <Grid ColumnDefinitions="30,32,*,110,70,90">
                        <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" MinHeight="0" />
                        <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="cyan b" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Codec}" Classes="text2 sm" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding Channels}" Classes="text2 sm" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding Language}" Classes="dim sm" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasSeveralSelected}">
            <StackPanel Spacing="12">
              <WrapPanel Orientation="Horizontal" ItemSpacing="28" LineSpacing="12">
                <HeaderedContentControl Classes="field" Header="Сохранение">
                  <Border Classes="seg">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="SeparateRadio" Classes="seg" GroupName="audioMode" Content="отдельный файл на дорожку" IsChecked="{Binding IsSeparate}" />
                      <RadioButton x:Name="SingleRadio" Classes="seg" GroupName="audioMode" Content="все выбранные в один .mka" IsChecked="{Binding IsSingleMka}" />
                    </StackPanel>
                  </Border>
                </HeaderedContentControl>
                <HeaderedContentControl Classes="field" Header="Имена" IsVisible="{Binding ShowsNumbering}">
                  <CheckBox Content="номер дорожки в имени папки и файла («1. AniLibria.TV»)" IsChecked="{Binding NumberTracks}" MinHeight="34" />
                </HeaderedContentControl>
              </WrapPanel>
              <StackPanel Spacing="6" IsVisible="{Binding ShowsOutputTracks}">
                <Grid Classes="hint">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <mi:MaterialIcon Kind="InformationOutline" />
                  <TextBlock Grid.Column="1" Text="Дорожки в .mka — по порядку; первая станет дорожкой по умолчанию." />
                </Grid>
                <ItemsControl x:Name="OutputList" ItemsSource="{Binding OutputTracks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="5" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="p:OutputTrackRowViewModel">
                      <Border Classes="box" Padding="8,5">
                        <Grid ColumnDefinitions="28,200,*,110,Auto">
                          <TextBlock Text="{Binding Position}" Classes="cyan b" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Source}" Classes="dim sm" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0" />
                          <ComboBox Grid.Column="2" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="тайтл"
                                    ItemsSource="{Binding $parent[UserControl].((p:AudioExtractPageViewModel)DataContext).Voices}"
                                    Text="{Binding Title}" />
                          <ComboBox Grid.Column="3" IsEditable="True" HorizontalAlignment="Stretch" Margin="6,0,0,0" PlaceholderText="язык"
                                    ItemsSource="{Binding $parent[UserControl].((p:AudioExtractPageViewModel)DataContext).LanguageCodes}"
                                    Text="{Binding Language}" />
                          <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Classes="icon" ToolTip.Tip="Выше" CommandParameter="{Binding}"
                                    Command="{Binding $parent[UserControl].((p:AudioExtractPageViewModel)DataContext).MoveUpCommand}">
                              <mi:MaterialIcon Kind="ArrowUp" />
                            </Button>
                            <Button Classes="icon" ToolTip.Tip="Ниже" CommandParameter="{Binding}"
                                    Command="{Binding $parent[UserControl].((p:AudioExtractPageViewModel)DataContext).MoveDownCommand}">
                              <mi:MaterialIcon Kind="ArrowDown" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <c:PlanPreviewView DataContext="{Binding Preview}" />
    </DockPanel>
  </DockPanel>
</UserControl>
