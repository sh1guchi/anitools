<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anitools.App.ViewModels"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
  <UserControl.Styles>
    <Style Selector="WrapPanel.fields">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="ItemSpacing" Value="18" />
      <Setter Property="LineSpacing" Value="12" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="pageBar">
      <Grid ColumnDefinitions="*,Auto">
        <Button Classes="link" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding OpenSettingsFolderCommand}"
                ToolTip.Tip="Открыть папку с настройками">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="FileCogOutline" Width="15" Height="15" />
            <TextBlock Text="{Binding SettingsPath}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="По умолчанию" Command="{Binding DefaultsCommand}" />
          <Button Content="Отменить изменения" Command="{Binding RevertCommand}" />
          <Button x:Name="SaveButton" Classes="primary lg" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="ContentSaveOutline" />
              <TextBlock Text="Сохранить" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <DockPanel Margin="22,18,22,0">
      <c:PageHeader DockPanel.Dock="Top" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto,14,Auto,18" Margin="0,0,12,0">

          <!-- Программы -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <c:CardHead Icon="ApplicationCogOutline" Title="Программы" Margin="0" />
              <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                         Text="Пусто — искать самим: FFMPEG_PATH/FFPROBE_PATH → PATH → Program Files. Можно указать файл или папку с программой." />
              <!-- по программам: FFmpeg, MKVToolNix, ImDisk — пути и «Установить» (последняя версия с сайта) -->
              <ItemsControl ItemsSource="{Binding Packages}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ToolPackageViewModel">
                    <Border Classes="box">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Classes="dim sm" TextWrapping="Wrap" Text="{Binding Caption}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="sm" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" Margin="10,0,0,0"
                                  ToolTip.Tip="Скачать последнюю версию с сайта и прописать пути">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <mi:MaterialIcon Kind="DownloadOutline" />
                              <TextBlock Text="{Binding InstallText}" />
                            </StackPanel>
                          </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding IsInstalling}">
                          <ProgressBar Classes="pbar" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Grid.RowSpan="2" Classes="ghost sm" Content="Отмена" Command="{Binding CancelInstallCommand}" Margin="10,0,0,0" />
                          <TextBlock Grid.Row="1" Classes="dim sm" Text="{Binding Stage}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ToolPathRow">
                              <HeaderedContentControl Classes="field" Header="{Binding Name}">
                                <StackPanel Spacing="4">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding Configured}" PlaceholderText="искать автоматически" />
                                    <Button Grid.Column="1" Classes="icon" Command="{Binding BrowseCommand}" ToolTip.Tip="Выбрать файл" Margin="4,0,0,0">
                                      <mi:MaterialIcon Kind="FolderSearchOutline" />
                                    </Button>
                                  </Grid>
                                  <StackPanel Orientation="Horizontal" Spacing="5">
                                    <mi:MaterialIcon Kind="CheckCircle" Classes="ok" Width="14" Height="14" IsVisible="{Binding IsFound}" />
                                    <mi:MaterialIcon Kind="CloseCircle" Classes="bad" Width="14" Height="14" IsVisible="{Binding !IsFound}" />
                                    <TextBlock Text="{Binding Found}" Classes="dim sm" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                </StackPanel>
                              </HeaderedContentControl>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Войс-лист -->
          <Border Grid.Column="2" Classes="card">
            <DockPanel>
              <c:CardHead DockPanel.Dock="Top" Icon="AccountVoice" Title="Войс-лист" Margin="0,0,0,10" />
              <TextBlock DockPanel.Dock="Top" Classes="dim" FontSize="12.5" Text="Названия озвучек для выбора — по одной в строке." Margin="0,0,0,8" />
              <TextBox x:Name="VoicesBox" Text="{Binding VoicesText}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="150"
                       VerticalContentAlignment="Top" />
            </DockPanel>
          </Border>

          <!-- HLS -->
          <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="card">
            <StackPanel Spacing="14">
              <c:CardHead Icon="LayersTripleOutline" Title="HLS" Margin="0" />
              <WrapPanel Classes="fields">
                <HeaderedContentControl Classes="field" Header="Кодирование">
                  <Border Classes="seg">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Classes="seg" GroupName="encoder" Content="видеокарта (NVENC)" IsChecked="{Binding UseNvenc}" />
                      <RadioButton Classes="seg" GroupName="encoder" Content="процессор (libx264)" IsChecked="{Binding !UseNvenc}" />
                    </StackPanel>
                  </Border>
                </HeaderedContentControl>
                <HeaderedContentControl Classes="field" Header="Качество">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="seg">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="seg" GroupName="cq" Content="постоянное CQ" IsChecked="{Binding UseFixedCq}" />
                        <RadioButton Classes="seg" GroupName="cq" Content="подбор CQ под размер" IsChecked="{Binding !UseFixedCq}" />
                      </StackPanel>
                    </Border>
                    <TextBox Text="{Binding FixedCq}" Width="64" IsEnabled="{Binding UseFixedCq}" HorizontalAlignment="Left" />
                  </StackPanel>
                </HeaderedContentControl>
                <HeaderedContentControl Classes="field" Header="Пресет NVENC">
                  <ComboBox ItemsSource="{Binding NvencPresets}" SelectedItem="{Binding NvencPreset}" Width="90" HorizontalAlignment="Left" />
                </HeaderedContentControl>
              </WrapPanel>
              <WrapPanel Classes="fields">
                <HeaderedContentControl Classes="field" Header="Потолок битрейта, × лестницы">
                  <TextBox Text="{Binding FixedCqPeak}" Width="96" HorizontalAlignment="Left" />
                </HeaderedContentControl>
                <HeaderedContentControl Classes="field" Header="Сегмент, с">
                  <TextBox Text="{Binding SegmentSeconds}" Width="96" HorizontalAlignment="Left" />
                </HeaderedContentControl>
                <HeaderedContentControl Classes="field" Header="Отдельный архив верхнего качества, ГБ">
                  <TextBox Text="{Binding SeparateTopZipGb}" Width="96" HorizontalAlignment="Left" />
                </HeaderedContentControl>
              </WrapPanel>
              <HeaderedContentControl Classes="field" Header="Подбор CQ: окон · допуск, % · проходов · CQ старт / мин / макс">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBox Text="{Binding CalibrationWindows}" Width="64" ToolTip.Tip="окон" HorizontalAlignment="Left" />
                  <TextBox Text="{Binding CalibrationTolerancePercent}" Width="64" ToolTip.Tip="допуск, %" HorizontalAlignment="Left" />
                  <TextBox Text="{Binding CalibrationMaxPasses}" Width="64" ToolTip.Tip="проходов" Margin="0,0,12,0" HorizontalAlignment="Left" />
                  <TextBox Text="{Binding CqStart}" Width="64" ToolTip.Tip="CQ старт" HorizontalAlignment="Left" />
                  <TextBox Text="{Binding CqMin}" Width="64" ToolTip.Tip="CQ мин" HorizontalAlignment="Left" />
                  <TextBox Text="{Binding CqMax}" Width="64" ToolTip.Tip="CQ макс" HorizontalAlignment="Left" />
                </StackPanel>
              </HeaderedContentControl>
              <StackPanel Spacing="6">
                <TextBlock Text="Лестница качеств" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}" />
                <Border Classes="tblHead" Padding="4,4">
                  <Grid ColumnDefinitions="70,180,*">
                    <TextBlock Text="Качество" />
                    <TextBlock Grid.Column="1" Text="Ширина × высота" />
                    <TextBlock Grid.Column="2" Text="Битрейт, кбит/с" />
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Ladder}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:LadderRowViewModel">
                      <Border Classes="tblRow" Padding="4,4">
                        <Grid ColumnDefinitions="70,180,*">
                          <TextBlock Text="{Binding Name}" Classes="cyan b" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBox Classes="sm" Text="{Binding Width}" Width="70" HorizontalAlignment="Left" />
                            <TextBlock Text="×" Classes="dim" VerticalAlignment="Center" />
                            <TextBox Classes="sm" Text="{Binding Height}" Width="70" HorizontalAlignment="Left" />
                          </StackPanel>
                          <TextBox Grid.Column="2" Classes="sm" Text="{Binding BitrateKbps}" Width="96" HorizontalAlignment="Left" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Временные файлы HLS -->
          <Border Grid.Row="4" Classes="card">
            <StackPanel Spacing="12">
              <c:CardHead Icon="Memory" Title="Временные файлы HLS" Caption="по умолчанию" Margin="0" />
              <Border Classes="seg">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="seg" GroupName="workdir" Content="RAM-диск (ImDisk)" IsChecked="{Binding IsRamDisk}" />
                  <RadioButton Classes="seg" GroupName="workdir" Content="папка" IsChecked="{Binding IsFolder}" />
                  <RadioButton Classes="seg" GroupName="workdir" Content="рядом с выходом" IsChecked="{Binding IsNearOutput}" />
                </StackPanel>
              </Border>
              <HeaderedContentControl Classes="field" Header="Папка">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding WorkDirFolder}" />
                  <Button Grid.Column="1" Classes="icon" Command="{Binding BrowseWorkDirCommand}" ToolTip.Tip="Выбрать папку" Margin="4,0,0,0">
                    <mi:MaterialIcon Kind="FolderSearchOutline" />
                  </Button>
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Classes="field" Header="Размер RAM-диска, ГБ">
                <StackPanel Spacing="6">
                  <TextBox Text="{Binding RamDiskGb}" Width="96" HorizontalAlignment="Left" />
                  <TextBlock Classes="dim sm" TextWrapping="Wrap"
                             Text="Создать диск может только администратор: если anitools запущен без этих прав, Windows спросит разрешение при первом RAM-диске (один раз за запуск)." />
                </StackPanel>
              </HeaderedContentControl>
            </StackPanel>
          </Border>

          <!-- Прочее -->
          <Border Grid.Row="4" Grid.Column="2" Classes="card">
            <StackPanel Spacing="12">
              <c:CardHead Icon="DotsHorizontalCircleOutline" Title="Прочее" Margin="0" />
              <HeaderedContentControl Classes="field" Header="API Shikimori">
                <TextBox Text="{Binding ShikimoriBaseUrl}" />
              </HeaderedContentControl>
              <HeaderedContentControl Classes="field" Header="Своя папка шрифтов">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding FontsCustomDir}" />
                  <Button Grid.Column="1" Classes="icon" Command="{Binding BrowseFontsDirCommand}" ToolTip.Tip="Выбрать папку" Margin="4,0,0,0">
                    <mi:MaterialIcon Kind="FolderSearchOutline" />
                  </Button>
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Classes="field" Header="Хардсаб: параметры ffmpeg">
                <TextBox Text="{Binding HardsubArgs}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap" />
              </HeaderedContentControl>
              <WrapPanel Classes="fields">
                <HeaderedContentControl Classes="field" Header="Хардсаб: папка шрифтов">
                  <TextBox Text="{Binding HardsubFontsDir}" Width="150" HorizontalAlignment="Left" />
                </HeaderedContentControl>
                <HeaderedContentControl Classes="field" Header="Сдвиг субтитров, с">
                  <TextBox Text="{Binding SubShiftSeconds}" Width="96" HorizontalAlignment="Left" />
                </HeaderedContentControl>
              </WrapPanel>
              <HeaderedContentControl Classes="field" Header="Сдвиг аудио: с · битрейт AAC · файлов сразу">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding AudioShiftSeconds}" Width="70" HorizontalAlignment="Left" />
                    <TextBox Text="{Binding AudioShiftBitrate}" Width="70" HorizontalAlignment="Left" />
                    <TextBox Text="{Binding AudioShiftWorkers}" Width="56" HorizontalAlignment="Left" />
                  </StackPanel>
                  <CheckBox Content="перекодировать в AAC (как в оригинале), а не сдвигать без потерь" IsChecked="{Binding AudioShiftReencode}" />
                </StackPanel>
              </HeaderedContentControl>
              <HeaderedContentControl Classes="field" Header="Перекодирование аудио: формат · битрейт · каналов · файлов сразу">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ComboBox ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding AudioConvertFormat}" Width="240" HorizontalAlignment="Left">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={x:Static v:Converters.AudioFormatLabel}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding AudioConvertBitrate}" Width="70" HorizontalAlignment="Left" />
                    <TextBox Text="{Binding AudioConvertChannels}" Width="80" PlaceholderText="как есть" HorizontalAlignment="Left" />
                    <TextBox Text="{Binding AudioConvertWorkers}" Width="56" HorizontalAlignment="Left" />
                  </StackPanel>
                  <CheckBox Content="чинить метки времени" IsChecked="{Binding AudioConvertFixTimestamps}" />
                </StackPanel>
              </HeaderedContentControl>
              <HeaderedContentControl Classes="field" Header="Команда ani">
                <CheckBox Content="закрывать консоль, из которой набрали ani (окно anitools остаётся)" IsChecked="{Binding CloseConsoleAfterAni}" />
              </HeaderedContentControl>
              <HeaderedContentControl Classes="field" Header="Обновления">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding VersionText}" Classes="text2" VerticalAlignment="Center" />
                    <Button Classes="sm" Command="{Binding CheckUpdatesNowCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Update" />
                        <TextBlock Text="Проверить сейчас" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <CheckBox Content="проверять раз в день при запуске (GitHub)" IsChecked="{Binding CheckUpdates}" />
                </StackPanel>
              </HeaderedContentControl>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</UserControl>
