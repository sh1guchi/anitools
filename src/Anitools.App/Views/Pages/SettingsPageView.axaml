<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anitools.App.ViewModels"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="0,3" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="24,18,24,16">
    <c:PageHeader DockPanel.Dock="Top" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <Button Classes="link" HorizontalAlignment="Left" Command="{Binding OpenSettingsFolderCommand}">
        <TextBlock Text="{Binding SettingsPath}" Classes="muted small" TextTrimming="CharacterEllipsis" />
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="По умолчанию" Command="{Binding DefaultsCommand}" />
        <Button Content="Отменить изменения" Command="{Binding RevertCommand}" />
        <Button x:Name="SaveButton" Classes="accent" Padding="20,8" Content="Сохранить" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" Margin="0,0,14,0">

        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Программы" />
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="Пусто — искать самим: FFMPEG_PATH/FFPROBE_PATH → PATH → Program Files. Можно указать файл или папку с программой." />
            <ItemsControl ItemsSource="{Binding ToolPaths}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ToolPathRow">
                  <Grid Classes="row" ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Classes="label" Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding Configured}" PlaceholderText="искать автоматически" />
                    <Button Grid.Column="2" Content="Обзор…" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="2,2,0,4">
                      <mi:MaterialIcon Kind="CheckCircle" Classes="ok" Width="14" Height="14" IsVisible="{Binding IsFound}" />
                      <mi:MaterialIcon Kind="CloseCircle" Classes="bad" Width="14" Height="14" IsVisible="{Binding !IsFound}" />
                      <TextBlock Text="{Binding Found}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Войс-лист" />
            <TextBlock Classes="muted small" Text="Названия озвучек для выбора — по одной в строке." />
            <TextBox x:Name="VoicesBox" Text="{Binding VoicesText}" AcceptsReturn="True" TextWrapping="NoWrap" Height="150" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="HLS" />
            <Grid Classes="row" ColumnDefinitions="220,*">
              <TextBlock Classes="label" Text="Кодирование" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <RadioButton GroupName="encoder" Content="видеокарта (NVENC)" IsChecked="{Binding UseNvenc}" />
                <RadioButton GroupName="encoder" Content="процессор (libx264)" IsChecked="{Binding !UseNvenc}" />
              </StackPanel>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,*">
              <TextBlock Classes="label" Text="Качество" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <RadioButton GroupName="cq" Content="постоянное CQ" IsChecked="{Binding UseFixedCq}" />
                <TextBox Text="{Binding FixedCq}" Width="70" IsEnabled="{Binding UseFixedCq}" />
                <RadioButton GroupName="cq" Content="подбор CQ под размер" IsChecked="{Binding !UseFixedCq}" />
              </StackPanel>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,Auto,*">
              <TextBlock Classes="label" Text="Потолок битрейта, × лестницы" />
              <TextBox Grid.Column="1" Text="{Binding FixedCqPeak}" Width="70" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,Auto,*">
              <TextBlock Classes="label" Text="Пресет NVENC" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding NvencPresets}" SelectedItem="{Binding NvencPreset}" Width="90" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,Auto,*">
              <TextBlock Classes="label" Text="Сегмент, с" />
              <TextBox Grid.Column="1" Text="{Binding SegmentSeconds}" Width="70" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,Auto,*">
              <TextBlock Classes="label" Text="Отдельный архив верхнего качества, ГБ" />
              <TextBox Grid.Column="1" Text="{Binding SeparateTopZipGb}" Width="70" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,*">
              <TextBlock Classes="label" Text="Подбор CQ" />
              <WrapPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="окон" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding CalibrationWindows}" Width="56" Margin="0,0,14,0" />
                <TextBlock Text="допуск, %" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding CalibrationTolerancePercent}" Width="56" Margin="0,0,14,0" />
                <TextBlock Text="проходов" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding CalibrationMaxPasses}" Width="56" Margin="0,0,14,0" />
                <TextBlock Text="CQ старт/мин/макс" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding CqStart}" Width="56" Margin="0,0,4,0" />
                <TextBox Text="{Binding CqMin}" Width="56" Margin="0,0,4,0" />
                <TextBox Text="{Binding CqMax}" Width="56" />
              </WrapPanel>
            </Grid>
            <TextBlock Text="Лестница качеств (ширина × высота, битрейт кбит/с)" Classes="muted" Margin="0,8,0,2" />
            <ItemsControl ItemsSource="{Binding Ladder}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:LadderRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                    <TextBlock Text="{Binding Name}" Width="60" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Text="{Binding Width}" Width="70" />
                    <TextBlock Text="×" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Height}" Width="70" />
                    <TextBox Text="{Binding BitrateKbps}" Width="90" Margin="12,0,0,0" />
                    <TextBlock Text="кбит/с" VerticalAlignment="Center" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Временные файлы HLS (по умолчанию)" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton GroupName="workdir" Content="RAM-диск (ImDisk)" IsChecked="{Binding IsRamDisk}" />
              <RadioButton GroupName="workdir" Content="папка" IsChecked="{Binding IsFolder}" />
              <RadioButton GroupName="workdir" Content="рядом с выходом" IsChecked="{Binding IsNearOutput}" />
            </StackPanel>
            <Grid Classes="row" ColumnDefinitions="220,*,Auto">
              <TextBlock Classes="label" Text="Папка" />
              <TextBox Grid.Column="1" Text="{Binding WorkDirFolder}" />
              <Button Grid.Column="2" Content="Обзор…" Command="{Binding BrowseWorkDirCommand}" Margin="6,0,0,0" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,Auto,*">
              <TextBlock Classes="label" Text="Размер RAM-диска, ГБ" />
              <TextBox Grid.Column="1" Text="{Binding RamDiskGb}" Width="70" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Прочее" />
            <Grid Classes="row" ColumnDefinitions="220,*">
              <TextBlock Classes="label" Text="API Shikimori" />
              <TextBox Grid.Column="1" Text="{Binding ShikimoriBaseUrl}" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,*,Auto">
              <TextBlock Classes="label" Text="Своя папка шрифтов" />
              <TextBox Grid.Column="1" Text="{Binding FontsCustomDir}" />
              <Button Grid.Column="2" Content="Обзор…" Command="{Binding BrowseFontsDirCommand}" Margin="6,0,0,0" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,*">
              <TextBlock Classes="label" Text="Хардсаб: параметры ffmpeg" />
              <TextBox Grid.Column="1" Text="{Binding HardsubArgs}" FontFamily="{StaticResource MonoFont}" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,Auto,*">
              <TextBlock Classes="label" Text="Хардсаб: папка шрифтов" />
              <TextBox Grid.Column="1" Text="{Binding HardsubFontsDir}" Width="160" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,*">
              <TextBlock Classes="label" Text="Сдвиг аудио" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBox Text="{Binding AudioShiftSeconds}" Width="70" />
                <TextBlock Text="с, AAC" VerticalAlignment="Center" />
                <TextBox Text="{Binding AudioShiftBitrate}" Width="70" />
                <TextBlock Text="файлов сразу" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBox Text="{Binding AudioShiftWorkers}" Width="56" />
              </StackPanel>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,*">
              <TextBlock Classes="label" Text="Перекодирование аудио" />
              <WrapPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding AudioConvertFormat}" Width="90" Margin="0,0,6,0" />
                <TextBox Text="{Binding AudioConvertBitrate}" Width="70" Margin="0,0,6,0" />
                <TextBlock Text="каналов" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding AudioConvertChannels}" Width="56" PlaceholderText="как есть" Margin="0,0,10,0" />
                <CheckBox Content="чинить метки времени" IsChecked="{Binding AudioConvertFixTimestamps}" Margin="0,0,10,0" />
                <TextBlock Text="файлов сразу" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding AudioConvertWorkers}" Width="56" />
              </WrapPanel>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="220,Auto,*">
              <TextBlock Classes="label" Text="Сдвиг субтитров, с" />
              <TextBox Grid.Column="1" Text="{Binding SubShiftSeconds}" Width="70" />
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
