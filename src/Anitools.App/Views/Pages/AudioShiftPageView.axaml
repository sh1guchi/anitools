<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.AudioShiftPageView"
             x:DataType="p:AudioShiftPageViewModel">
  <DockPanel Margin="24,18,24,16">
    <c:PageHeader DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Сдвиг, с:" VerticalAlignment="Center" />
          <TextBox x:Name="SecondsBox" Text="{Binding Seconds}" Width="80" />
          <TextBlock Text="AAC" VerticalAlignment="Center" Margin="16,0,0,0" />
          <TextBox Text="{Binding Bitrate}" Width="70" />
          <TextBlock Text="файлов сразу" VerticalAlignment="Center" Margin="16,0,0,0" />
          <TextBox Text="{Binding Workers}" Width="56" />
        </StackPanel>
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Плюс — тишина в начало (звук позже), минус — начало обрезается (звук раньше). Выход — папка «audio_fixed», AAC в .mka." />
      </StackPanel>
    </Border>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <Button x:Name="RunButton" Grid.Column="1" Classes="accent" Padding="20,8" Command="{Binding RunCommand}"
              IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}"
              Content="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
    </Grid>
    <c:PlanPreviewView DataContext="{Binding Preview}" />
  </DockPanel>
</UserControl>
