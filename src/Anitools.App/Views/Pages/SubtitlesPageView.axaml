<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             x:Class="Anitools.App.Views.Pages.SubtitlesPageView"
             x:DataType="p:SubtitlesPageViewModel">
  <DockPanel Margin="24,18,24,16">
    <c:PageHeader DockPanel.Dock="Top" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <Button x:Name="RunButton" Grid.Column="1" Classes="accent" Padding="20,8" Command="{Binding RunCommand}"
              IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}"
              Content="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
    </Grid>
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12"
            IsVisible="{Binding Tracks.Count, Converter={x:Static v:Converters.IsPositive}}">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="h2" Text="Дорожки субтитров" />
          <TextBlock Classes="muted" Text="{Binding TracksCaption}" VerticalAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Width="80" MinWidth="0" IsVisible="{Binding IsPlanning}" VerticalAlignment="Center" />
        </StackPanel>
        <ListBox x:Name="TracksList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" MaxHeight="190"
                 Background="Transparent" Grid.IsSharedSizeScope="True">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="p:SubtitleTrackRowViewModel">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="N" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="C" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Id}" Classes="muted" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,18,0" />
                <TextBlock Grid.Column="2" Text="{Binding Codec}" Margin="0,0,18,0" />
                <TextBlock Grid.Column="3" Text="{Binding Language}" Classes="muted" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="Искать в каждой серии:" VerticalAlignment="Center" />
          <RadioButton GroupName="subMode" Content="по ID" IsChecked="{Binding IsById}" />
          <RadioButton x:Name="ByTitleRadio" GroupName="subMode" Content="по тайтлу" IsChecked="{Binding IsByTitle}" />
          <RadioButton GroupName="subMode" Content="по языку" IsChecked="{Binding IsByLanguage}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="Тип:" VerticalAlignment="Center" />
          <RadioButton GroupName="subKind" Content="надписи → папка «надписи», «.надписи»" IsChecked="{Binding IsSigns}" />
          <RadioButton x:Name="SubsRadio" GroupName="subKind" Content="сабы → папка «сабы», «.сабы»" IsChecked="{Binding IsSubs}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <c:PlanPreviewView DataContext="{Binding Preview}" />
  </DockPanel>
</UserControl>
