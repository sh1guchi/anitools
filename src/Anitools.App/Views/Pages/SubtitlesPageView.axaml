<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             xmlns:v="using:Anitools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Anitools.App.Views.Pages.SubtitlesPageView"
             x:DataType="p:SubtitlesPageViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="pageBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <mi:MaterialIcon Kind="InformationOutline" Classes="cyan" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Grid.Column="1" Classes="text2" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                   Text="Дорожки из каждой серии — в папки «надписи» и «сабы» (приписки «.надписи» / «.сабы»), за один запуск. Не нужна папка — «—»." />
        <Button x:Name="RunButton" Grid.Column="2" Classes="primary lg" Command="{Binding RunCommand}"
                IsEnabled="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.IsPositive}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Play" />
            <TextBlock x:Name="RunText" Text="{Binding Preview.CheckedCount, Converter={x:Static v:Converters.RunText}}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <DockPanel Margin="22,18,22,14">
      <c:PageHeader DockPanel.Dock="Top" />
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14"
              IsVisible="{Binding Tracks.Count, Converter={x:Static v:Converters.IsPositive}}">
        <StackPanel Spacing="12">
          <c:CardHead Icon="SubtitlesOutline" Title="Дорожки субтитров" Caption="{Binding TracksCaption}" Margin="0">
            <Panel Width="16" Height="16" IsVisible="{Binding IsPlanning}">
              <Ellipse Classes="spinTrack" />
              <Arc Classes="spin" />
            </Panel>
          </c:CardHead>
          <Border Classes="tblHead" Padding="8,4">
            <Grid ColumnDefinitions="40,*,190,60,Auto">
              <TextBlock Text="ID" />
              <TextBlock Grid.Column="1" Text="Тайтл" />
              <TextBlock Grid.Column="2" Text="Кодек" />
              <TextBlock Grid.Column="3" Text="Язык" />
              <TextBlock Grid.Column="4" Text="Куда извлечь" Width="250" />
            </Grid>
          </Border>
          <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled" Margin="0,-12,0,0">
            <ItemsControl x:Name="TracksList" ItemsSource="{Binding Tracks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="p:SubtitleTrackRowViewModel">
                  <Border Classes="tblRow">
                    <Grid ColumnDefinitions="40,*,190,60,Auto">
                      <TextBlock Text="{Binding Id}" Classes="cyan b" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Codec}" Classes="text2 sm" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="3" Text="{Binding Language}" Classes="dim sm" VerticalAlignment="Center" />
                      <!-- у каждой строки своя группа вариантов (без GroupName — по родительской панели) -->
                      <Border Grid.Column="4" Classes="seg" Width="250">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton Classes="seg" Content="—" IsChecked="{Binding IsNone}" Width="50" ToolTip.Tip="Не извлекать" />
                          <RadioButton Classes="seg" Content="надписи" IsChecked="{Binding IsSigns}" Width="100" />
                          <RadioButton Classes="seg" Content="сабы" IsChecked="{Binding IsSubs}" Width="98" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <HeaderedContentControl Classes="field" Header="Искать в каждой серии">
            <Border Classes="seg">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="seg" GroupName="subMode" Content="по ID" IsChecked="{Binding IsById}" />
                <RadioButton x:Name="ByTitleRadio" Classes="seg" GroupName="subMode" Content="по тайтлу" IsChecked="{Binding IsByTitle}" />
                <RadioButton Classes="seg" GroupName="subMode" Content="по языку" IsChecked="{Binding IsByLanguage}" />
              </StackPanel>
            </Border>
          </HeaderedContentControl>
        </StackPanel>
      </Border>
      <c:PlanPreviewView DataContext="{Binding Preview}" />
    </DockPanel>
  </DockPanel>
</UserControl>
