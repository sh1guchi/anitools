<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Anitools.App.ViewModels.Pages"
             xmlns:c="using:Anitools.App.Views.Controls"
             x:Class="Anitools.App.Views.Pages.PlaceholderPageView"
             x:DataType="p:PlaceholderPageViewModel">
  <DockPanel Margin="24,18,24,16">
    <c:PageHeader DockPanel.Dock="Top" />
    <StackPanel Spacing="8" Margin="0,8,0,0">
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
      <TextBlock Classes="muted" Text="Экран появится в следующей части этапа 7 (docs/PLAN.md §4)." TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</UserControl>
