<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/anitools.ico"
        x:Class="Anitools.App.Views.Dialogs.MessageDialog"
        Width="480" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner">
  <!-- как .dlg: заголовок, текст, кнопки справа -->
  <StackPanel>
    <TextBlock x:Name="TitleText" Classes="h2" FontSize="17" Margin="20,18,20,4" TextWrapping="Wrap" />
    <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}" LineHeight="21" Margin="20,8,20,6" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="20,14,20,18">
      <Button x:Name="CancelButton" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
      <Button x:Name="ConfirmButton" Classes="primary" MinWidth="90" HorizontalContentAlignment="Center" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
