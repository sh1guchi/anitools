<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Anitools.App.Views.Dialogs.MessageDialog"
        Width="480" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="18">
    <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="ConfirmButton" Classes="accent" MinWidth="90" HorizontalContentAlignment="Center" IsDefault="True" />
      <Button x:Name="CancelButton" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
