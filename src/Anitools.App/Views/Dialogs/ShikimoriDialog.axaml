<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anitools.App.ViewModels"
        xmlns:sh="using:Anitools.Core.Shikimori"
        xmlns:v="using:Anitools.App.Views"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        Icon="/Assets/anitools.ico"
        x:Class="Anitools.App.Views.Dialogs.ShikimoriDialog"
        x:DataType="vm:ShikimoriPickerViewModel"
        Title="Поиск на Shikimori"
        Width="860" Height="560" MinWidth="640" MinHeight="400"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20,18,20,18">
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
      <StackPanel Spacing="2">
        <TextBlock Classes="h2" FontSize="17" Text="Тайтл на Shikimori" />
        <TextBlock Classes="dim" FontSize="13" Text="{Binding Title, StringFormat='Название из файлов: {0}'}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Название для поиска">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Classes="primary" Margin="8,0,0,0" Command="{Binding SearchCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="Magnify" />
            <TextBlock Text="Искать" />
          </StackPanel>
        </Button>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSearching}">
        <Panel Width="16" Height="16">
          <Ellipse Classes="spinTrack" />
          <Arc Classes="spin" />
        </Panel>
        <TextBlock Classes="dim" FontSize="13" Text="ищу…" VerticalAlignment="Center" />
      </StackPanel>
      <Border Classes="note err" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="Auto,*">
          <mi:MaterialIcon Kind="AlertCircleOutline" VerticalAlignment="Top" Margin="0,1,9,0" />
          <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />
        </Grid>
      </Border>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,14,0,0">
      <TextBlock Text="ID вручную" Classes="text2" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding ManualId}" Width="110" />
      <Button Grid.Column="2" Content="Взять ID" Command="{Binding UseManualIdCommand}" Margin="6,0,0,0" />
      <Button Grid.Column="4" Classes="ghost" Content="Пропустить" Command="{Binding SkipCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="5" Classes="primary" Content="Выбрать" Command="{Binding ChooseCommand}" IsDefault="True" />
    </Grid>

    <ListBox x:Name="ResultsList" Classes="rows" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="sh:ShikimoriAnime">
          <Grid ColumnDefinitions="70,*,90,50,50,Auto">
            <TextBlock Text="{Binding Id}" Classes="dim sm" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,10,0">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Russian}" Classes="dim sm" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="2" Classes="badge" HorizontalAlignment="Left">
              <TextBlock Text="{Binding KindName}" />
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding Episodes, Converter={x:Static v:Converters.EmptyIfZero}}" Classes="text2 sm" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
            <TextBlock Grid.Column="4" Text="{Binding Year}" Classes="text2 sm" VerticalAlignment="Center" />
            <Button Grid.Column="5" Classes="icon sm" ToolTip.Tip="Открыть на сайте" Click="OnOpenSite" Tag="{Binding}">
              <mi:MaterialIcon Kind="OpenInNew" />
            </Button>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
