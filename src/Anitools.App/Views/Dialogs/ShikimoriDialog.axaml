<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anitools.App.ViewModels"
        xmlns:sh="using:Anitools.Core.Shikimori"
        xmlns:v="using:Anitools.App.Views"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Anitools.App.Views.Dialogs.ShikimoriDialog"
        x:DataType="vm:ShikimoriPickerViewModel"
        Title="Поиск на Shikimori"
        Width="860" Height="560" MinWidth="640" MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <TextBlock Classes="muted" Text="{Binding Title, StringFormat='Название из файлов: {0}'}" TextTrimming="CharacterEllipsis" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Название для поиска">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" Command="{Binding SearchCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="Magnify" />
            <TextBlock Text="Искать" />
          </StackPanel>
        </Button>
      </Grid>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" MinWidth="0" />
      <TextBlock Text="{Binding Message}" Classes="error" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,12,0,0">
      <TextBlock Text="ID вручную:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding ManualId}" Width="110" />
      <Button Grid.Column="2" Content="Взять ID" Command="{Binding UseManualIdCommand}" Margin="6,0,0,0" />
      <Button Grid.Column="4" Content="Пропустить" Command="{Binding SkipCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="5" Classes="accent" Content="Выбрать" Command="{Binding ChooseCommand}" IsDefault="True" />
    </Grid>

    <Border Classes="card" Padding="6">
      <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="sh:ShikimoriAnime">
            <Grid ColumnDefinitions="70,*,90,50,50,Auto">
              <TextBlock Text="{Binding Id}" Classes="muted" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,10,0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Russian}" Classes="muted small" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding KindName}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{Binding Episodes, Converter={x:Static v:Converters.EmptyIfZero}}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
              <TextBlock Grid.Column="4" Text="{Binding Year}" VerticalAlignment="Center" />
              <Button Grid.Column="5" Classes="icon" ToolTip.Tip="Открыть на сайте" Click="OnOpenSite" Tag="{Binding}">
                <mi:MaterialIcon Kind="OpenInNew" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
