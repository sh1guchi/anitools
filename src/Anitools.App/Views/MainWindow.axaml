<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anitools.App.ViewModels"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Anitools.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="anitools"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Шапка: ▌ ANITOOLS by shiguchi + рабочая папка -->
    <Border Grid.Row="0"
            Padding="16,10"
            Background="{StaticResource HeaderBackgroundBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,28,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="5" Height="26" CornerRadius="1" Background="{StaticResource AccentBrush}" />
          <TextBlock Text="ANITOOLS" FontSize="20" FontWeight="Bold" LetterSpacing="2" VerticalAlignment="Center" />
          <TextBlock Text="by shiguchi" Opacity="0.55" VerticalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="2" Classes="link" HorizontalAlignment="Left" VerticalAlignment="Center"
                Command="{Binding OpenFolderInExplorerCommand}"
                ToolTip.Tip="Рабочая папка — открыть в проводнике. Сменить: «Обзор», «Недавние» или перетащить папку на окно.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="FolderOpen" Classes="accent" Width="20" Height="20" />
            <TextBlock x:Name="FolderText" Text="{Binding FolderDisplay}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="BrowseButton" Command="{Binding BrowseCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="FolderSearchOutline" />
              <TextBlock Text="Обзор…" />
            </StackPanel>
          </Button>
          <Button x:Name="RecentButton" IsEnabled="{Binding HasRecentFolders}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="History" />
              <TextBlock Text="Недавние" />
              <mi:MaterialIcon Kind="ChevronDown" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" />
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Предупреждение: папка не найдена, настройки не прочитались -->
    <Border Grid.Row="1" Classes="message" Margin="16,8,16,0"
            IsVisible="{Binding FolderMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <mi:MaterialIcon Kind="AlertCircleOutline" Classes="bad" VerticalAlignment="Center" Margin="0,0,8,0" />
        <SelectableTextBlock x:Name="FolderMessageText" Grid.Column="1" Text="{Binding FolderMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="icon" Command="{Binding DismissFolderMessageCommand}" ToolTip.Tip="Скрыть">
          <mi:MaterialIcon Kind="Close" />
        </Button>
      </Grid>
    </Border>

    <!-- Навигация по инструментам и страница -->
    <Grid Grid.Row="2" ColumnDefinitions="232,*">
      <Border Background="{StaticResource NavBackgroundBrush}"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,0,1,0">
        <ListBox x:Name="NavList"
                 ItemsSource="{Binding Navigation}"
                 SelectedItem="{Binding SelectedNav}"
                 Background="Transparent"
                 Padding="6,4">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:INavItem">
              <Setter Property="IsEnabled" Value="{Binding IsPage}" />
              <Setter Property="Padding" Value="10,5" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="CornerRadius" Value="4" />
            </Style>
          </ListBox.Styles>
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:NavHeader">
              <TextBlock Classes="navHeader" Text="{Binding Title}" Margin="0,10,0,0" />
            </DataTemplate>
            <DataTemplate DataType="vm:NavSeparator">
              <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,6" />
            </DataTemplate>
            <DataTemplate DataType="vm:PageViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <mi:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" Opacity="0.85" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="6,0" MinWidth="18"
                        IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Border>
      <ContentControl x:Name="PageHost" Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>

    <!-- Строка состояния: программы и текущая задача -->
    <Border Grid.Row="3"
            Padding="12,4"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ItemsControl x:Name="ToolChipsList" ItemsSource="{Binding ToolChips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ToolChip">
              <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                <TextBlock Text="{Binding Text}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                <mi:MaterialIcon Kind="CheckCircle" Classes="ok" Width="14" Height="14" IsVisible="{Binding Ok}" />
                <mi:MaterialIcon Kind="CloseCircle" Classes="bad" Width="14" Height="14" IsVisible="{Binding !Ok}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Column="2" Classes="link" Command="{Binding ShowJobsCommand}"
                IsVisible="{Binding CurrentJob, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ProgressBar Width="120" MinWidth="0" Maximum="100" VerticalAlignment="Center"
                         Value="{Binding CurrentJob.Progress, FallbackValue=0}"
                         IsIndeterminate="{Binding CurrentJob.IsIndeterminate, FallbackValue=False}" />
            <TextBlock x:Name="CurrentJobText" Text="{Binding CurrentJob.Short, FallbackValue=''}" FontSize="12"
                       MaxWidth="560" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="VersionText" Grid.Column="2" Text="{Binding Version}" FontSize="12" Opacity="0.55" VerticalAlignment="Center"
                   IsVisible="{Binding CurrentJob, Converter={x:Static ObjectConverters.IsNull}}" />
      </Grid>
    </Border>

  </Grid>
</Window>
